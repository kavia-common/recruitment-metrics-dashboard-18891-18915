# Database (PostgreSQL)
POSTGRES_URL=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=recruitment
POSTGRES_PORT=5432

# Flask
FLASK_ENV=development
SQLALCHEMY_ECHO=0

# SMTP / Email Notifications
# Set SMTP_HOST and NOTIFY_EMAIL_FROM to enable email notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey_or_username
SMTP_PASSWORD=your_password_or_key
# Use TLS (STARTTLS) or SSL. Typically TLS on port 587.
SMTP_USE_TLS=1
SMTP_USE_SSL=0
# From address for notification emails
NOTIFY_EMAIL_FROM=notifications@example.com
# Optional default recipients (comma separated). Services may use this list.
NOTIFY_EMAIL_TO=talent-ops@example.com, hiring-managers@example.com
