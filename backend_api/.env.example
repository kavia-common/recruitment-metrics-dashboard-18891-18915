# Backend API Environment Configuration

# Application
FLASK_ENV=development
PORT=3001
SQLALCHEMY_ECHO=0

# Database (PostgreSQL)
# You can either provide a full DSN in POSTGRES_URL (postgresql+psycopg://...) OR
# provide host, user, password, db, and port details below.
# If POSTGRES_URL starts with "postgresql", it will be used directly.
POSTGRES_URL=localhost
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5000

# Email Notifications (optional)
# Configure to enable email notifications on key events.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
NOTIFY_EMAIL_FROM=
# Comma-separated recipients for default notifications (optional)
NOTIFY_EMAIL_TO=
