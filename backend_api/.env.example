# Database configuration (required)
POSTGRES_URL=localhost
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5000

# Flask environment
FLASK_ENV=development
SQLALCHEMY_ECHO=0
PORT=3001

# (Optional) Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_USE_SSL=0
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
